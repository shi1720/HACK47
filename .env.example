PORT=3087
HOST=127.0.0.1
DATABASE_PATH=./data/batchlight.sqlite
NODE_ENV=development
# Set to your exact HTTPS URL in production. Do not include a trailing slash.
APP_ORIGIN=http://localhost:5180
# Set to 1 only when exactly one trusted reverse proxy fronts the app.
TRUST_PROXY=0
# Production requires NODE_ENV=production and an HTTPS APP_ORIGIN.
